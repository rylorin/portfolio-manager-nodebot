{
  "name": "nodebot",
  "repository": {
    "url": "https://github.com/rylorin/nodebot"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/",
    "LICENSE"
  ],
  "scripts": {
    "bot:updater": "node dist/index.js -watch -update",
    "build": "yarn run server:build && yarn run client:build",
    "build:watch": "yarn tsc --watch",
    "clean": "rm -rf dist",
    "client:build": "vite build",
    "client:dev": "vite",
    "dev": "concurrently \"yarn server:dev\" \"yarn client:dev\"",
    "doc": "typedoc --excludeInternal",
    "doc:dev": "typedoc --out ./doc-dev",
    "lint": "eslint ./src",
    "prepare": "husky",
    "prepublishOnly": "yarn build",
    "qc": "prettier --check . && stylelint \"**/*.css\" && yarn lint && tsc --noEmit",
    "release": "yarn lint && yarn qc && yarn doc && yarn build && yarn run storybook:build",
    "serve": "vite preview",
    "server:build": "tsc --project tsconfig.server.json",
    "server:dev": "ts-node-dev --project tsconfig.server.json -r tsconfig-paths/register src/index -watch -server -account -import -trader",
    "start": "yarn && node dist/index.js -server -watch"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@stoqey/ib": "^1.5.3",
    "@tanstack/react-table": "^8.21.3",
    "chakra-react-select": "^6.1.1",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "fast-xml-parser": "^5.7.3",
    "formik": "^2.4.9",
    "json-stringify-safe": "^5.0.1",
    "luxon": "^3.7.2",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sqlite3": "^5.1.7",
    "winston": "^3.19.0",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/json-stringify-safe": "^5.0.3",
    "@types/node": "^22.19.17",
    "@types/node-cron": "^3.0.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-loader": "^10.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "http-proxy-middleware": "^3.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "rxjs": "7.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^40.0.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.2.2",
    "webpack": "^5.106.2"
  },
  "engines": {
    "node": "^22.21.1"
  }
}
